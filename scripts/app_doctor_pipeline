
# ---------------- Detailed Human + Technical Diagnostics ----------------
# This layer is intentionally deterministic: it translates common Expo/Android
# failures into an explanation a non-technical user can understand while
# preserving technical evidence for developers.

ERROR_RULES = [
    {
        "name": "Node.js / Expo SDK incompatibility",
        "patterns": [r"Unsupported engine", r"EBADENGINE", r"node.*version", r"requires a peer of.*node"],
        "stage": "Expo dependency setup",
        "human": "Your project requires a different Node.js version from the one currently being used. Expo and its packages can refuse to install or run when the Node version is outside their supported range.",
        "action": "The Doctor will determine the project's required Node version, switch to a compatible runtime when possible, reinstall dependencies, and retry.",
        "confidence": 0.96,
    },
    {
        "name": "JavaScript dependency conflict",
        "patterns": [r"ERESOLVE", r"peer dep", r"peer dependency", r"Could not resolve dependency"],
        "stage": "JavaScript dependency installation",
        "human": "Two or more JavaScript packages in your Expo project are asking for incompatible versions of a dependency. The package manager cannot create a dependency tree that satisfies all of them.",
        "action": "The Doctor will inspect the dependency tree and lockfile, identify the packages causing the conflict, and attempt a safe compatible resolution before rebuilding.",
        "confidence": 0.94,
    },
    {
        "name": "Expo configuration / config-plugin failure",
        "patterns": [r"expo prebuild", r"config plugin", r"plugin.*error", r"with.*plugin", r"app\.config"],
        "stage": "Expo prebuild",
        "human": "Expo could not turn your Expo configuration into the native Android project. This usually means an Expo config plugin, app configuration value, or native configuration step is incompatible or malformed.",
        "action": "The Doctor will inspect app.json/app.config.*, Expo plugins, and the prebuild output, then attempt a safe configuration repair and regenerate the Android project.",
        "confidence": 0.90,
    },
    {
        "name": "Android SDK component missing",
        "patterns": [r"failed to find target", r"SDK location", r"platforms;android-", r"build-tools.*not found", r"licenses.*not accepted"],
        "stage": "Android environment / Gradle",
        "human": "The Android build environment is missing an Android SDK component required by your project. This is a machine setup problem rather than necessarily a problem in your app.",
        "action": "The Doctor will identify the requested Android API/build-tools version, install the required SDK component when available, accept required licenses, and retry.",
        "confidence": 0.98,
    },
    {
        "name": "Java / JDK compatibility",
        "patterns": [r"Unsupported class file major version", r"JAVA_HOME", r"JDK", r"java.*version", r"invalid source release", r"invalid target release"],
        "stage": "Android environment / Gradle",
        "human": "The Android build is using a Java version that does not match what the Expo/React Native/Gradle toolchain expects. Android compilation therefore stopped before the APK could be produced.",
        "action": "The Doctor will detect the required Java/Gradle combination, configure a compatible JDK where possible, and rebuild.",
        "confidence": 0.95,
    },
    {
        "name": "Gradle memory / resource failure",
        "patterns": [r"Java heap space", r"OutOfMemoryError", r"GC overhead", r"daemon.*memory"],
        "stage": "Android compilation",
        "human": "The Android compiler ran out of available memory while building your app. The project may be valid; the build machine simply did not have enough memory configured for Gradle.",
        "action": "The Doctor will adjust Gradle memory settings within safe limits, clean the affected build state, and retry.",
        "confidence": 0.97,
    },
    {
        "name": "Android resource / manifest failure",
        "patterns": [r"mergeDebugResources", r"processDebugResources", r"Android resource linking failed", r"Manifest merger failed"],
